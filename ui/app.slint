// Easy Agent — Slint UI.
//
// Mirrors the Flutter client: a connection form (base URL + token), a session
// list, and a chat screen with a streamed transcript + composer. All state is
// driven from Rust; this file is pure presentation.

import { VerticalBox, HorizontalBox, ScrollView, Button, LineEdit, ListView } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "Easy Agent";
    preferred-width: 480px;
    preferred-height: 820px;
    background: #0d1117;

    in property <bool> connected: false;
    in-out property <string> base-url: "https://agent.agent.10.199.64.20.nip.io";
    in-out property <string> token: "";
    in property <string> status: "";

    // session list
    in property <[string]> sessions: [];
    in-out property <int> selected-session: -1;

    // chat
    in property <string> chat-title: "";
    in property <[string]> transcript: [];
    in-out property <string> composer: "";

    // navigation: the active tab and the top page key (see src/navigation.rs)
    in-out property <string> tab: "chat";
    in property <string> page: "chat_list";

    // config / providers / mailbox page data
    in property <[string]> config-items: ["appearance", "backends", "presets", "tools"];
    in property <[string]> providers: [];
    in property <[string]> mailbox: [];

    callback connect-clicked();
    callback new-session();
    callback refresh-clicked();
    callback session-picked(int);
    callback send-clicked();
    callback back-clicked();
    callback tab-clicked(string);
    callback config-item-clicked(string);
    callback providers-clicked();
    callback mailbox-clicked();

    VerticalBox {
        // ---- header ----
        Rectangle {
            height: 48px;
            background: #161b22;
            Text {
                text: root.chat-title == "" ? "Easy Agent" : root.chat-title;
                color: #e6edf3;
                font-size: 16px;
                font-weight: 700;
                vertical-alignment: center;
                x: 12px;
            }
        }

        if !root.connected : VerticalBox {
            spacing: 10px;
            padding: 16px;
            Text { text: "Gateway URL"; color: #8b98a9; }
            LineEdit { text <=> root.base-url; }
            Text { text: "Token"; color: #8b98a9; }
            LineEdit { text <=> root.token; }
            Button { text: "Connect"; clicked => { root.connect-clicked(); } }
            Text { text: root.status; color: #d97706; wrap: word-wrap; }
        }

        // ---- config tab ----
        if root.connected && root.tab == "config" : VerticalBox {
            HorizontalBox {
                height: 40px;
                padding-left: 12px;
                padding-right: 12px;
                spacing: 6px;
                Text { text: "Settings"; color: #e6edf3; vertical-alignment: center; horizontal-stretch: 1; }
                Button { text: "Back"; clicked => { root.back-clicked(); } }
            }
            if root.page == "providers_list" : ListView {
                vertical-stretch: 1;
                for p in root.providers : Rectangle {
                    height: 40px;
                    Text { x: 12px; vertical-alignment: center; text: p; color: #e6edf3; }
                }
            }
            if root.page != "providers_list" : ListView {
                vertical-stretch: 1;
                for c in root.config-items : Rectangle {
                    height: 44px;
                    background: #161b22;
                    Text { x: 12px; vertical-alignment: center; text: c; color: #e6edf3; }
                    TouchArea { clicked => { root.config-item-clicked(c); } }
                }
            }
        }

        // ---- mailbox overlay ----
        if root.connected && root.page == "chat_overlay" : ListView {
            vertical-stretch: 1;
            for m in root.mailbox : Rectangle {
                height: 40px;
                Text { x: 12px; vertical-alignment: center; text: m; color: #e6edf3; }
            }
        }

        if root.connected && root.tab == "chat" && root.chat-title == "" : VerticalBox {
            HorizontalBox {
                height: 40px;
                padding-left: 12px;
                padding-right: 12px;
                spacing: 6px;
                Text { text: "Sessions (" + root.sessions.length + ")"; color: #e6edf3; vertical-alignment: center; horizontal-stretch: 1; }
                Button { text: "New"; clicked => { root.new-session(); } }
                Button { text: "Refresh"; clicked => { root.refresh-clicked(); } }
            }
            ListView {
                vertical-stretch: 1;
                for name[i] in root.sessions : Rectangle {
                    height: 44px;
                    background: i == root.selected-session ? #21262d : transparent;
                    Text {
                        x: 12px;
                        vertical-alignment: center;
                        text: name;
                        color: #e6edf3;
                    }
                    TouchArea {
                        clicked => {
                            root.selected-session = i;
                            root.session-picked(i);
                        }
                    }
                }
            }
            Text { text: root.status; color: #8b98a9; wrap: word-wrap; }
        }

        if root.connected : HorizontalBox {
            height: 44px;
            Button { text: "Chat"; horizontal-stretch: 1; clicked => { root.tab-clicked("chat"); } }
            Button { text: "Settings"; horizontal-stretch: 1; clicked => { root.tab-clicked("config"); } }
        }

        if root.connected && root.tab == "chat" && root.chat-title != "" : VerticalBox {
            ScrollView {
                vertical-stretch: 1;
                VerticalBox {
                    padding: 12px;
                    spacing: 10px;
                    for msg in root.transcript : Rectangle {
                        background: #161b22;
                        border-radius: 8px;
                        height: t.preferred-height + 16px;
                        t := Text {
                            x: 8px;
                            y: 8px;
                            width: parent.width - 16px;
                            text: msg;
                            color: #e6edf3;
                            wrap: word-wrap;
                        }
                    }
                }
            }
            HorizontalBox {
                padding: 8px;
                spacing: 6px;
                Button { text: "Back"; clicked => { root.back-clicked(); } }
                LineEdit {
                    horizontal-stretch: 1;
                    text <=> root.composer;
                    accepted => { root.send-clicked(); }
                }
                Button { text: "Send"; clicked => { root.send-clicked(); } }
            }
        }
    }
}
